{
  "name": "playwright-spec-qa",
  "version": "0.2.0",
  "description": "AI-powered staging QA: parse Playwright specs with @qa-scenario annotations and judge live staging pages with Hermes agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lodado/playwright-spec-for-AI-Agent.git"
  },
  "homepage": "https://github.com/lodado/playwright-spec-for-AI-Agent#readme",
  "bugs": {
    "url": "https://github.com/lodado/playwright-spec-for-AI-Agent/issues"
  },
  "keywords": [
    "playwright",
    "qa",
    "e2e",
    "hermes",
    "ai",
    "staging"
  ],
  "bin": {
    "playwright-spec-qa": "./bin/playwright-spec-qa.mjs",
    "hermes-qa": "./bin/playwright-spec-qa.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "hermes-qa.config.example.mjs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "qa:spec": "node bin/playwright-spec-qa.mjs spec",
    "qa:judge": "node bin/playwright-spec-qa.mjs judge",
    "qa:slack": "node bin/playwright-spec-qa.mjs slack",
    "qa:nightly": "node bin/playwright-spec-qa.mjs nightly",
    "test": "vitest run",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
