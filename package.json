{
  "name": "playwright-spec-for-ai-agent",
  "version": "6.0.0",
  "description": "AI-assisted live staging QA layer for Playwright test suites. Parses @qa-scenario annotations from *.spec.ts into structured QA scenarios, then uses Hermes Agent to log into staging, visit target pages, and judge live DOM against test intent — returning pass, fail, manual_review, or skip without running Playwright against staging or mutating billing state.",
  "type": "module",
  "license": "MIT",
  "author": "lodado <ycp998@naver.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lodado/playwright-spec-for-AI-Agent.git"
  },
  "homepage": "https://github.com/lodado/playwright-spec-for-AI-Agent#readme",
  "bugs": {
    "url": "https://github.com/lodado/playwright-spec-for-AI-Agent/issues"
  },
  "keywords": [
    "playwright",
    "playwright-test",
    "e2e",
    "qa",
    "staging",
    "live-qa",
    "live-staging",
    "hermes",
    "hermes-agent",
    "ai",
    "ai-qa",
    "testing",
    "test-automation",
    "cli",
    "nightly",
    "slack",
    "qa-scenario",
    "manual-review"
  ],
  "bin": {
    "playwright-spec-for-ai-agent": "./bin/playwright-spec-for-ai-agent.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "playwright-spec-for-ai-agent.config.example.mjs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "qa:spec": "node bin/playwright-spec-for-ai-agent.mjs spec",
    "qa:abstract-ai": "node bin/playwright-spec-for-ai-agent.mjs abstract-ai",
    "qa:judge": "node bin/playwright-spec-for-ai-agent.mjs judge",
    "qa:review": "node bin/playwright-spec-for-ai-agent.mjs review",
    "qa:slack": "node bin/playwright-spec-for-ai-agent.mjs slack",
    "qa:nightly": "node bin/playwright-spec-for-ai-agent.mjs nightly",
    "test": "vitest run",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
