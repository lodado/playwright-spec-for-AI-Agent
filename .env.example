# Copy to .env.local (or .env) in your project root. Before it spawns a stage
# the CLI loads ./.env.local, then ./.env — earlier wins, and a variable already
# exported in the real environment (or a CI secret) beats both. CLI flags win
# over everything. Never commit the filled-in file — it holds staging credentials.
#
# --env-file=<path> replaces both defaults with that one file. To skip env-file
# loading entirely, export QA_NO_ENV_FILE=1 in the real environment — setting it
# in this file is a no-op, because the file is only read after that check.
#
# Every name below is read by the code. Anything not listed here (BROWSER_CDP_URL,
# GITHUB_STEP_SUMMARY, GITHUB_SERVER_URL, GITHUB_REPOSITORY, GITHUB_RUN_ID, CI,
# USER, PATH) is supplied by the harness, GitHub Actions, or the OS — do not set
# it here.

# ── Required ──────────────────────────────────────────────────────────────────
# Staging account used by Playwright and the QA agent to log in. `judge` does not
# ask for these when it already has a session: a `login` browser profile, an
# attached browser (QA_BROWSER_CDP_URL below), or staging.storageState in the
# project config.
STAGING_QA_EMAIL=your-email@example.com
STAGING_QA_PASSWORD=your-password

# ── Staging target ────────────────────────────────────────────────────────────
# Base URL of your staging environment.
# The value below is a PLACEHOLDER and is rejected before a live run — replace it.
STAGING_QA_BASE_URL=https://your-staging-url.example.com

# Path to the login page (default: /login)
STAGING_QA_LOGIN_PATH=/login

# Default path used when building login context (override per-page with --target-path)
STAGING_QA_DASHBOARD_PATH=/dashboard

# Whether the target page needs a login at all (default: true).
# Accepts 1/true/yes/y/on and 0/false/no/n/off; anything else is ignored.
STAGING_QA_AUTH_REQUIRED=

# ── Account context (optional) ────────────────────────────────────────────────
# Tell the agent / Playwright which @qa-scenario block to use (ACTIVE | INACTIVE | CANCEL_PENDING).
# Same values can be set in playwright-spec-for-ai-agent.config.mjs under
# staging.expectedAccountState (legacy alias: staging.expectedSubscriptionStatus).
# Priority: CLI --expected-subscription-status= > env > config file > interactive prompt > DOM infer
STAGING_QA_EXPECTED_PLAN=BASIC
STAGING_QA_EXPECTED_ACCOUNT_STATE=INACTIVE

# Legacy alias, read only when STAGING_QA_EXPECTED_ACCOUNT_STATE is unset.
STAGING_QA_EXPECTED_SUBSCRIPTION_STATUS=

# Free-text note forwarded verbatim to the agent prompt
STAGING_QA_ACCOUNT_NOTES=

# ── Agent backend ─────────────────────────────────────────────────────────────
# Which backend judges (default: hermes). Built-ins: hermes | aside | exec |
# fixture. Also accepts a module specifier resolved from your project root —
# "./qa-adapters/my-agent.mjs" or "@acme/qa-adapter" — exporting
# run(query, maxTurns, options).
QA_AI_ADAPTER=

# `fixture` only: directory of canned per-stage payloads named abstract.json,
# judge.json, and review.json. Per-stage — a missing <stage>.json falls back to
# the built-in fixture, so you can pin just one stage; a directory that does not
# exist is an error. Unset = built-in fixtures, which read the prompt and always
# answer manual_review so an offline run is never mistaken for green.
QA_FIXTURE_DIR=

# ── exec adapter ──────────────────────────────────────────────────────────────
# Required when QA_AI_ADAPTER=exec: the agent CLI to run. The prompt is piped on
# stdin; the CLI must print JSON on stdout.
QA_AGENT_CMD=

# Set to "cdp-attach" only if that CLI's browser tools honor BROWSER_CDP_URL, so
# it can reuse the harness's pre-authenticated browser. Anything else (default)
# means credentials-in-prompt and no runner-owned video.
QA_AGENT_AUTH=

# Wall-clock cap for one exec agent run, in ms (default: 600000).
QA_AGENT_TIMEOUT_MS=

# ── Hermes adapter ────────────────────────────────────────────────────────────
# RESERVED — not user-configurable. Any value other than "hermes-agent" aborts
# the run. Listed only so the name is not mistaken for a supported override.
# HERMES_QA_COMMAND=hermes-agent

# Inference model used by Hermes (read from ~/.hermes/config.yaml by default)
HERMES_INFERENCE_MODEL=

# Optional base URL override for a self-hosted or proxy inference endpoint
HERMES_INFERENCE_BASE_URL=

# Toolsets disabled for the JSON-in/JSON-out stages, abstract-ai and review
# (default: browser,web,terminal). The memory toolset is always disabled on top
# of this, so nothing learned in one run carries into the next.
HERMES_QA_DISABLED_TOOLSETS=

# Wall-clock cap for one Hermes run, in ms (default: 600000).
HERMES_QA_TIMEOUT_MS=

# API key for the provider named in ~/.hermes/config.yaml — the variable name is
# that provider uppercased plus _API_KEY (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# hermes-agent refuses to start without it even when the model is configured;
# `doctor`'s "adapter provider" check looks here and in ~/.hermes/.env.
# ANTHROPIC_API_KEY=

# ── Aside adapter ─────────────────────────────────────────────────────────────
# RESERVED — as with Hermes, any value other than "aside" aborts the run.
# ASIDE_QA_COMMAND=aside

# Model and reasoning effort passed to `aside exec`. Unset = Aside user settings.
ASIDE_QA_MODEL=
ASIDE_QA_EFFORT=

# Wall-clock cap for one Aside run, in ms (default: 600000).
ASIDE_QA_TIMEOUT_MS=

# ── Browser session (optional) ────────────────────────────────────────────────
# CDP endpoint of a browser you already run and already signed into. `judge`
# attaches to it instead of the private profile `login` creates — the only path
# that works with an identity provider that refuses automated browsers.
# Applies to cdp-attach adapters only; --cdp-url= wins over this.
#
# Start that browser with a DEDICATED profile directory. Attaching to your
# everyday Chrome hands the agent every site you are signed into:
#   google-chrome --remote-debugging-port=9222 --user-data-dir=/tmp/qa-chrome
# Run `login --attach` to print the full recipe.
#
# An attached browser records a trace, screenshots, and aria snapshots, but no
# HAR and no video — the run reports that instead of implying it captured them.
QA_BROWSER_CDP_URL=

# ── Judge behaviour (optional) ────────────────────────────────────────────────
# Turn budget for the judge. Default scales with the plan (12 + 8 per executable
# test, clamped); any positive integer here wins.
QA_JUDGE_MAX_TURNS=

# Any non-empty value records Playwright video into {outputDir}/videos. Only
# applies when the runner launches the browser itself (a cdp-attach adapter on
# the `login` profile); an attached browser records no video.
QA_RECORD_VIDEO=

# ── Config strictness (optional) ──────────────────────────────────────────────
# 1 = unknown/typo'd or wrongly typed config keys abort the run instead of
# printing a warning. Recommended in CI. Same as passing --strict-config.
QA_STRICT_CONFIG=

# ── Output directories (optional) ─────────────────────────────────────────────
# Global override for all pages (default: src/page/{page}/__QA__/)
QA_OUTPUT_DIR=

# Per-page override, applied only to the page named "dashboard"
DASHBOARD_QA_OUTPUT_DIR=

# ── Slack (optional) ──────────────────────────────────────────────────────────
# Incoming webhook URL — required only for qa:slack / qa:nightly --with-slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
