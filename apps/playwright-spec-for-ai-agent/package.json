{
  "name": "playwright-spec-for-ai-agent",
  "version": "0.9.0",
  "description": "AI-assisted live staging QA layer for Playwright test suites. Parses @qa-scenario annotations from *.spec.ts into structured QA scenarios, then uses Hermes Agent to log into staging, visit target pages, and judge live DOM against test intent \u2014 returning pass, fail, manual_review, or skip without running Playwright against staging or mutating billing state.",
  "type": "module",
  "license": "MIT",
  "author": "lodado <ycp998@naver.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lodado/playwright-spec-for-AI-Agent.git"
  },
  "homepage": "https://github.com/lodado/playwright-spec-for-AI-Agent#readme",
  "bugs": {
    "url": "https://github.com/lodado/playwright-spec-for-AI-Agent/issues"
  },
  "keywords": [
    "playwright",
    "playwright-test",
    "e2e",
    "qa",
    "staging",
    "live-qa",
    "live-staging",
    "hermes",
    "hermes-agent",
    "ai",
    "ai-qa",
    "testing",
    "test-automation",
    "cli",
    "nightly",
    "slack",
    "qa-scenario",
    "manual-review"
  ],
  "bin": {
    "qa-native": "./bin/qa-native.mjs",
    "playwright-spec-for-ai-agent": "./bin/playwright-spec-for-ai-agent.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "playwright-spec-for-ai-agent.config.example.mjs",
    "examples",
    "README.md",
    "packages/cli/index.mjs",
    "packages/cli/qa-native-adaptive-evidence.mjs",
    "packages/cli/qa-native-run-envelope.mjs",
    "packages/cli/qa-native.mjs",
    "packages/cli/qa-native-execute.mjs",
    "packages/cli/qa-native-judge.mjs",
    "packages/cli/qa-native-publish-issue.mjs",
    "packages/cli/qa-native-propose-patch.mjs",
    "packages/cli/qa-native-report.mjs",
    "packages/contracts/index.mjs",
    "packages/adapter-playwright/index.mjs",
    "packages/core/index.mjs",
    "packages/evidence/index.mjs",
    "packages/judge/index.mjs",
    "packages/provider-hermes/index.mjs",
    "packages/provider-playwright/index.mjs",
    "packages/remediation/index.mjs",
